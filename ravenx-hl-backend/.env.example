# ── Required to boot ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ravenx
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Encrypts agent private keys in the DB. Keep it out of the DB host's backups and
# never lose it: without it, stored agents can't sign and users must re-approve.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate with "new,old" — the first key encrypts, every key decrypts.
AGENT_KEY_ENCRYPTION_KEY=
# Hyperliquid network: mainnet | testnet. Must match NEXT_PUBLIC_HL_ENV in the
# frontend, or the copy flow refuses to start.
HL_ENV=mainnet

# ── Builder fee (RavenX revenue) ──────────────────────────────────────────────
# Leave BUILDER_ADDRESS empty to run without fees — no fee is attached to
# orders and users are never asked to approve one.
# The builder account must hold >= 100 USDC of perps account value on HL.
BUILDER_ADDRESS=
# Fee in tenths of a basis point. 30 = 0.03%. HL caps perps at 100 (0.1%).
BUILDER_FEE_TENTHS_BPS=30

# ── Optional tuning ───────────────────────────────────────────────────────────
MIN_POSITION_SIZE_USD=10.0
TRADER_SCAN_INTERVAL_MINUTES=30
NONCE_EXPIRY_SECONDS=300
# Seconds a generated agent waits in memory for the user's HL approval
AGENT_PENDING_TTL_SECONDS=600
# Delete agent private keys for subscriptions stopped longer ago than this
AGENT_KEY_GC_DAYS=90
# Wallet discovery for the public leaderboard (harvesters, scanner, price feed).
# Off by default — copying doesn't need it. Set to 1 to turn it back on, and set
# NEXT_PUBLIC_ENABLE_LEADERBOARD=1 in the frontend to match.
ENABLE_LEADERBOARD=
# Set to any value to skip background workers (useful for scripts and tests)
DISABLE_BACKGROUND_WORKERS=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
