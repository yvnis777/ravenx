# /etc/systemd/system/ravenx-frontend.service
[Unit]
Description=RavenX frontend (Next.js)
After=network-online.target ravenx-backend.service
Wants=network-online.target

[Service]
User=ravenx
Group=ravenx
WorkingDirectory=/opt/ravenx/ravenx-frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --port 3000 --hostname 127.0.0.1
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
